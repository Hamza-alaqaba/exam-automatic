name: بناء تطبيق أندرويد (Build Android APK)

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-apk:
    name: بناء ملف APK للأندرويد
    runs-on: ubuntu-latest

    steps:
      - name: 1. تنزيل كود المشروع
        uses: actions/checkout@v4

      - name: 2. إعداد بيئة جافا (Java 17)
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: 3. إعداد بيئة نود (Node 20)
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: 4. تثبيت حزم المشروع
        run: npm install --legacy-peer-deps

      - name: 5. بناء واجهة الويب
        run: npm run build

      - name: 6. مزامنة كود أندرويد
        run: npx cap sync android

      - name: 7. منح صلاحية تنفيذ Gradle
        run: chmod +x android/gradlew

      - name: 8. تجميع وبناء ملف APK
        run: |
          cd android
          ./gradlew assembleDebug --no-daemon --stacktrace

      - name: 9. رفع وتجهيز ملف الـ APK للتحميل المباشر
        uses: actions/upload-artifact@v4
        with:
          name: Yemen-OMR-Scanner-APK
          path: android/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 30
